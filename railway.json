{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./Dockerfile",
    "watchPatterns": [
      "requirements.txt",
      "package.json",
      "frontend/**",
      "backend/**",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn backend.wsgi:application --bind 0.0.0.0:8000",
    "restartPolicyType": "ON_FAILURE"
  }
}
